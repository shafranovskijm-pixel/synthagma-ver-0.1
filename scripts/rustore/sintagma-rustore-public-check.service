[Unit]
Description=Check public SINTAGMA RuStore card availability
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /opt/sintagma-mobile/check_rustore_public.py --output /srv/sintagma-mobile/rustore-availability.json --timeout 15
TimeoutStartSec=45
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sintagma-mobile
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
SyslogIdentifier=sintagma-rustore-public-check
