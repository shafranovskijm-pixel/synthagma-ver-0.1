  "constraints": [
    {
      "definition": "FOREIGN KEY (company_id) REFERENCES companies(id) ON DELETE SET NULL",
      "name": "org_contracts_company_id_fkey"
    },
    {
      "definition": "CHECK (((counterparty_type IS NULL) OR (counterparty_type = ANY (ARRAY['individual'::text, 'legal'::text]))))",
      "name": "org_contracts_counterparty_type_check"
    },
    {
      "definition": "CHECK ((generation_status = ANY (ARRAY['draft'::text, 'generated'::text, 'failed'::text])))",
      "name": "org_contracts_generation_status_check"
    },
    {
      "definition": "FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE",
      "name": "org_contracts_organization_id_fkey"
    },
    {
      "definition": "CHECK ((pdf_status = ANY (ARRAY['unavailable'::text, 'pending'::text, 'ready'::text])))",
      "name": "org_contracts_pdf_status_check"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "org_contracts_pkey"
    },
    {
      "definition": "FOREIGN KEY (student_group_id) REFERENCES student_groups(id) ON DELETE SET NULL",
      "name": "org_contracts_student_group_id_fkey"
    },
    {
      "definition": "FOREIGN KEY (student_user_id) REFERENCES auth.users(id) ON DELETE SET NULL",
      "name": "org_contracts_student_user_id_fkey"
    },
    {
      "definition": "CHECK (((submission_snapshot_sha256 IS NULL) OR (submission_snapshot_sha256 ~ '^[0-9a-f]{64}$'::text)))",
      "name": "org_contracts_submission_snapshot_sha256_check"
    },
    {
      "definition": "CHECK ((template_format = ANY (ARRAY['html'::text, 'docx_ooxml'::text])))",
      "name": "org_contracts_template_format_check"
    },
    {
      "definition": "FOREIGN KEY (template_id) REFERENCES org_contract_templates(id) ON DELETE SET NULL",
      "name": "org_contracts_template_id_fkey"
    }
  ],
  "policies": [
    {
      "cmd": "DELETE",
      "permissive": "PERMISSIVE",
      "policyname": "Org members can delete own contracts",
      "qual": "((organization_id = current_organization_id()) OR has_role('admin'::app_role, auth.uid()))",
